---
/**
 * 在线思考捕获工作台 — /capture/（C-9 #13 / RFC-002）
 *
 * 安全不变量：
 * 1. 纯静态客户端工具页，源码与构建产物不含任何凭据或私钥；
 * 2. noindex + data-pagefind-ignore="all"，不进入搜索引擎与站内 Pagefind 索引；
 * 3. 写入前强制校验目标仓库 GitHub API 返回 `private === true`，拒绝向公开库直接写入；
 * 4. 结构化沉淀模式内置同源 V-010 敏感信息实时雷达，命中即阻断放入 staged/。
 */
import Base from "../layouts/Base.astro";
---

<Base
  title="思考捕获工作台"
  description="双库物理隔离的在线思考捕获与结构化知识沉淀工具台。"
  noindex={true}
  pagefindIgnore={true}
>
  <header class="page-head">
    <h1>思考捕获工作台</h1>
    <p class="page-head__desc">
      双库物理隔离 · 零服务端凭据 · 日常思考直存私有仓库，脱敏条目经受控 PR 同步公开知识站。
    </p>
  </header>

  <!-- 顶部双库隔离机制说明条 + 手机免配置快捷入口 -->
  <section class="wb-banner" aria-label="双库物理隔离机制说明">
    <div class="wb-banner__grid">
      <div class="wb-banner__item">
        <strong>日常思考 → 私有库 <code>inbox/</code>（100% 私密）</strong>
        <p>
          随手记录的闪念、阅读笔记与原始复盘（L3 私密级）仅写入私有仓库，永不触碰公开仓库 Git 历史。
        </p>
      </div>
      <div class="wb-banner__item">
        <strong>脱敏草稿 → 私有库 <code>staged/</code> → 公开站 PR</strong>
        <p>
          整理成熟的内容经浏览器端 V-010 敏感预检后存入 <code>staged/</code>，触发同步工作流向公开站发起待审草稿 PR。
        </p>
      </div>
    </div>
    <div class="wb-banner__footer">
      <a
        class="wb-btn wb-btn--secondary"
        href="https://github.com/cvcingcvc-code/personal-knowledge-vault/issues/new?template=thought.yml"
        target="_blank"
        rel="noopener noreferrer"
      >
        手机免配置快捷入口（私有库 Issue 表单）↗
      </a>
      <span class="wb-hint">
        已在手机登录 GitHub 时，无需在本页配置浏览器令牌即可随手提交思考。
      </span>
    </div>
  </section>

  <!-- 可折叠：私有库连接设置 -->
  <details class="wb-card wb-settings" id="wb-settings" open>
    <summary class="wb-settings__summary">
      <span class="wb-settings__title">私有库连接设置</span>
      <span class="badge" id="conn-badge">未配置本机令牌</span>
    </summary>

    <div class="wb-settings__body">
      <div class="wb-grid wb-grid--2">
        <div class="wb-field">
          <label class="wb-label" for="cfg-repo">目标私有仓库（owner/repo）</label>
          <input
            id="cfg-repo"
            class="wb-input"
            type="text"
            value="cvcingcvc-code/personal-knowledge-vault"
            autocomplete="off"
            spellcheck="false"
          />
        </div>
        <div class="wb-field">
          <label class="wb-label" for="cfg-branch">目标分支</label>
          <input
            id="cfg-branch"
            class="wb-input"
            type="text"
            value="main"
            autocomplete="off"
            spellcheck="false"
          />
        </div>
      </div>

      <div class="wb-field">
        <label class="wb-label" for="cfg-token">GitHub Fine-Grained Token（仅存本机浏览器）</label>
        <input
          id="cfg-token"
          class="wb-input"
          type="password"
          autocomplete="off"
          spellcheck="false"
          placeholder="粘贴仅授权私有库读写的 Fine-grained Token"
        />
        <p class="wb-hint">
          最小权限原则：请仅授权单个私有仓库 <code>Contents: Read and write</code>（如需网页一键触发同步工作流，另勾选 <code>Actions: Read and write</code>），切勿授权公开仓库写权限。令牌仅保存在本机 <code>localStorage</code>，直连 <code>api.github.com</code>。
        </p>
      </div>

      <div class="wb-actions">
        <button type="button" class="wb-btn wb-btn--primary" id="btn-verify-conn">
          保存并验证连接
        </button>
        <button type="button" class="wb-btn wb-btn--ghost" id="btn-clear-conn">
          清除本机令牌
        </button>
      </div>

      <div class="wb-alert" id="conn-status" role="status" aria-live="polite" hidden></div>
    </div>
  </details>

  <!-- 模式切换 Tabs -->
  <div class="wb-tabs">
    <div class="wb-tablist" role="tablist" aria-label="思考捕获模式">
      <button
        type="button"
        role="tab"
        id="tab-btn-quick"
        aria-controls="panel-quick"
        aria-selected="true"
        class="wb-tab is-active"
      >
        快速思考（直存 inbox/）
      </button>
      <button
        type="button"
        role="tab"
        id="tab-btn-struct"
        aria-controls="panel-struct"
        aria-selected="false"
        class="wb-tab"
      >
        结构化沉淀（脱敏入 staged/）
      </button>
    </div>

    <!-- Tab 1：快速思考（默认激活） -->
    <section
      id="panel-quick"
      role="tabpanel"
      aria-labelledby="tab-btn-quick"
      class="wb-card wb-panel"
    >
      <!-- Obsidian 式今日流速记模式控制栏 -->
      <div class="daily-stream-bar" aria-label="今日流式速记模式">
        <div class="daily-stream-bar__left">
          <strong>⏱️ 今日流速记 (Daily Notes)</strong>
          <span class="wb-hint">免起标题 · 自动时间戳 · 随手即记</span>
        </div>
        <button type="button" class="daily-stream-btn" id="btn-quick-timestamp">
          <span>+ 插入当前时刻</span>
        </button>
      </div>

      <div class="wb-field">
        <label class="wb-label" for="quick-title">标题（可选）</label>
        <input
          id="quick-title"
          class="wb-input"
          type="text"
          maxlength="100"
          placeholder="留空则按当前本地日期时间自动生成标题"
        />
      </div>

      <div class="wb-field">
        <!-- Obsidian 沉浸式编辑器控制栏 -->
        <div class="obsidian-editor-bar">
          <div class="obsidian-editor-modes" role="group" aria-label="快速思考视图模式">
            <button type="button" class="obsidian-mode-btn is-active" data-editor="quick" data-mode="edit">📝 编辑</button>
            <button type="button" class="obsidian-mode-btn" data-editor="quick" data-mode="split">🌗 分屏</button>
            <button type="button" class="obsidian-mode-btn" data-editor="quick" data-mode="preview">👁️ 预览</button>
          </div>
          <div class="obsidian-toolbar" data-editor="quick">
            <button type="button" class="obsidian-tool-btn" data-tool="bold" title="粗体 (Ctrl+B)">B</button>
            <button type="button" class="obsidian-tool-btn" data-tool="italic" title="斜体 (Ctrl+I)">I</button>
            <button type="button" class="obsidian-tool-btn" data-tool="h2" title="二级标题">H2</button>
            <button type="button" class="obsidian-tool-btn" data-tool="quote" title="引用">&gt;</button>
            <button type="button" class="obsidian-tool-btn" data-tool="code" title="代码块">&lt;/&gt;</button>
            <button type="button" class="obsidian-tool-btn" data-tool="task" title="待办清单">- [ ]</button>
            <button type="button" class="obsidian-tool-btn" data-tool="wikilink" title="插入双向链接 [[">[[ ]]</button>
            <button type="button" class="obsidian-tool-btn" data-tool="tag" title="插入受控标签 #">#</button>
          </div>
          <div class="obsidian-meta-status">
            <span class="obsidian-autosave-indicator" id="quick-autosave-indicator">● 草稿已暂存</span>
            <span class="obsidian-word-count" id="quick-word-count">0 字</span>
          </div>
        </div>

        <div class="obsidian-editor-wrapper mode-edit" id="quick-editor-wrap">
          <textarea
            id="quick-body"
            class="obsidian-textarea"
            rows="9"
            placeholder="随时记录灵光一现的思考、问题推演或当日流水…… 支持 [[双向链接 与 #标签 实时联想，Ctrl+Enter 保存"
          ></textarea>
          <div class="obsidian-preview-pane markdown-body" id="quick-preview-pane"></div>
        </div>
      </div>

      <div class="wb-field">
        <label class="wb-label" for="quick-tags">标签（可选，英文逗号分隔）</label>
        <input
          id="quick-tags"
          class="wb-input"
          type="text"
          placeholder="例如：mental-model, architecture, reading"
        />
      </div>

      <p class="wb-path-bar">
        写入路径预览：<code id="quick-path-preview">inbox/...</code>
        <span class="badge">privacy_level: L3</span>
      </p>

      <div class="wb-actions">
        <button type="button" class="wb-btn wb-btn--primary" id="btn-save-inbox">
          存入私有库 inbox/
        </button>
        <button type="button" class="wb-btn wb-btn--ghost" id="btn-clear-quick">
          清空草稿
        </button>
      </div>

      <div class="wb-alert" id="quick-result" role="status" aria-live="polite" hidden></div>
    </section>

    <!-- Tab 2：结构化沉淀（脱敏草稿 → staged/） -->
    <section
      id="panel-struct"
      role="tabpanel"
      aria-labelledby="tab-btn-struct"
      class="wb-card wb-panel"
      hidden
    >
      <div class="wb-grid wb-grid--2">
        <div class="wb-field">
          <label class="wb-label" for="st-type">内容类型（C-1）</label>
          <select id="st-type" class="wb-select">
            <option value="knowledge">知识条目（knowledge）</option>
            <option value="journal">每日复盘（journal）</option>
            <option value="error">错误经验（error）</option>
            <option value="project">项目记录（project）</option>
          </select>
        </div>

        <div class="wb-field">
          <label class="wb-label" for="st-id">条目 ID（C-2 唯一编号）</label>
          <input
            id="st-id"
            class="wb-input"
            type="text"
            value="KB-ENG-007"
            autocomplete="off"
            spellcheck="false"
          />
        </div>
      </div>

      <div class="wb-field" id="st-slug-wrap">
        <label class="wb-label" for="st-slug">文件短名 slug（仅小写字母、数字与连字符）</label>
        <input
          id="st-slug"
          class="wb-input"
          type="text"
          value="dual-repo-capture"
          autocomplete="off"
          spellcheck="false"
          placeholder="例如：git-rebase-notes（拼在 id 小写前缀之后）"
        />
      </div>

      <div class="wb-field">
        <label class="wb-label" for="st-title">标题 title（必填，4..80 字符）</label>
        <input
          id="st-title"
          class="wb-input"
          type="text"
          maxlength="80"
          placeholder="清晰概括这条核心结论或复盘主题（4..80 字）"
        />
      </div>

      <div class="wb-field">
        <div class="wb-label-row">
          <label class="wb-label" for="st-summary">一句话摘要 summary（必填，20..200 字符）</label>
          <span class="wb-draft-note" id="st-summary-count">0 / 20..200 字</span>
        </div>
        <textarea
          id="st-summary"
          class="wb-textarea"
          rows="2"
          maxlength="200"
          placeholder="用一句话说明这条内容解决什么具体问题或沉淀了什么可复用结论（20..200 字符）"
        ></textarea>
      </div>

      <div class="wb-grid wb-grid--2">
        <div class="wb-field">
          <label class="wb-label" for="st-tags">受控标签 tags（逗号分隔 kebab-case）</label>
          <input
            id="st-tags"
            class="wb-input"
            type="text"
            placeholder="例如：architecture, workflow, note-taking"
          />
        </div>
        <div class="wb-field">
          <label class="wb-label" for="st-vault-ref">关联私密原稿指针 vault_ref（可选）</label>
          <input
            id="st-vault-ref"
            class="wb-input"
            type="text"
            autocomplete="off"
            spellcheck="false"
            placeholder="例如：vault:inbox/2026/raw-note.md"
          />
        </div>
      </div>

      <!-- 类型专属字段：knowledge -->
      <fieldset class="wb-fieldset" data-type-group="knowledge">
        <legend class="wb-fieldset__legend">知识专属字段（C-5）</legend>
        <div class="wb-grid wb-grid--3">
          <div class="wb-field">
            <label class="wb-label" for="kb-domain">领域 domain</label>
            <select id="kb-domain" class="wb-select">
              <option value="engineering">engineering（ENG）</option>
              <option value="product">product（PRD）</option>
              <option value="design">design（DSN）</option>
              <option value="data">data（DAT）</option>
              <option value="finance">finance（FIN）</option>
              <option value="language">language（LNG）</option>
              <option value="health">health（HLT）</option>
              <option value="life">life（LIF）</option>
              <option value="meta">meta（MET）</option>
            </select>
          </div>
          <div class="wb-field">
            <label class="wb-label" for="kb-status">状态 status</label>
            <select id="kb-status" class="wb-select">
              <option value="seed">seed（萌芽待核实）</option>
              <option value="verified">verified（已核实，需填来源）</option>
              <option value="stale">stale（待复核）</option>
              <option value="archived">archived（归档）</option>
            </select>
          </div>
          <div class="wb-field">
            <label class="wb-label" for="kb-confidence">可信度 confidence</label>
            <select id="kb-confidence" class="wb-select">
              <option value="medium">medium</option>
              <option value="high">high（需非 AI 来源）</option>
              <option value="low">low</option>
            </select>
          </div>
        </div>

        <div class="wb-grid wb-grid--3">
          <div class="wb-field">
            <label class="wb-label" for="kb-source-kind">来源类型 source.kind</label>
            <select id="kb-source-kind" class="wb-select">
              <option value="experience">experience（亲历实践）</option>
              <option value="url">url（网页文档）</option>
              <option value="book">book（书籍）</option>
              <option value="paper">paper（论文）</option>
              <option value="course">course（课程）</option>
              <option value="person">person（交流）</option>
              <option value="agent">agent（AI 辅助）</option>
            </select>
          </div>
          <div class="wb-field">
            <label class="wb-label" for="kb-source-ref">来源引用 source.ref</label>
            <input
              id="kb-source-ref"
              class="wb-input"
              type="text"
              placeholder="书名、官方文档链接或实践项目说明（verified 必填）"
            />
          </div>
          <div class="wb-field">
            <label class="wb-label" for="kb-source-locator">来源定位 locator（可选）</label>
            <input
              id="kb-source-locator"
              class="wb-input"
              type="text"
              placeholder="章节号、小节标题或提交记录"
            />
          </div>
        </div>
      </fieldset>

      <!-- 类型专属字段：journal -->
      <fieldset class="wb-fieldset" data-type-group="journal" hidden>
        <legend class="wb-fieldset__legend">每日复盘专属字段（C-7，默认 draft + self-reported）</legend>
        <div class="wb-grid wb-grid--2">
          <div class="wb-field">
            <label class="wb-label" for="dj-date">复盘日期 date（自动同步 ID 与文件名）</label>
            <input id="dj-date" class="wb-input" type="date" />
          </div>
          <div class="wb-field">
            <label class="wb-label" for="dj-energy">精力状态 energy（可选，1..5）</label>
            <select id="dj-energy" class="wb-select">
              <option value="">不记录</option>
              <option value="5">5 — 充沛专注</option>
              <option value="4">4 — 稳定推进</option>
              <option value="3">3 — 常态平稳</option>
              <option value="2">2 — 略显疲惫</option>
              <option value="1">1 — 亟需休整</option>
            </select>
          </div>
        </div>
        <div class="wb-grid wb-grid--2">
          <div class="wb-field">
            <label class="wb-label" for="dj-did">今日完成 did（必填，每行一项）</label>
            <textarea
              id="dj-did"
              class="wb-textarea"
              rows="3"
              placeholder="每行填写一项已完成的实质进展（至少 1 项）"
            ></textarea>
          </div>
          <div class="wb-field">
            <label class="wb-label" for="dj-learned">今日收获 learned（必填，每行一项）</label>
            <textarea
              id="dj-learned"
              class="wb-textarea"
              rows="3"
              placeholder="每行填写一条新认知或经验总结（至少 1 项）"
            ></textarea>
          </div>
        </div>
        <div class="wb-grid wb-grid--2">
          <div class="wb-field">
            <label class="wb-label" for="dj-blocked">卡点 blocked（可选，每行一项）</label>
            <textarea
              id="dj-blocked"
              class="wb-textarea"
              rows="2"
              placeholder="可选：当前阻碍或待外部确认事项"
            ></textarea>
          </div>
          <div class="wb-field">
            <label class="wb-label" for="dj-tomorrow">明日计划 tomorrow（可选，每行一项）</label>
            <textarea
              id="dj-tomorrow"
              class="wb-textarea"
              rows="2"
              placeholder="可选：下一步优先推进事项"
            ></textarea>
          </div>
        </div>
      </fieldset>

      <!-- 类型专属字段：error -->
      <fieldset class="wb-fieldset" data-type-group="error" hidden>
        <legend class="wb-fieldset__legend">错误经验五要素（C-8，每项必填且至少 8 个字）</legend>
        <div class="wb-grid wb-grid--3">
          <div class="wb-field">
            <label class="wb-label" for="er-occurred">发生日期 occurred</label>
            <input id="er-occurred" class="wb-input" type="date" />
          </div>
          <div class="wb-field">
            <label class="wb-label" for="er-severity">严重程度 severity</label>
            <select id="er-severity" class="wb-select">
              <option value="medium">medium</option>
              <option value="high">high</option>
              <option value="low">low</option>
            </select>
          </div>
          <div class="wb-field">
            <label class="wb-label" for="er-project">关联项目 ID（可选）</label>
            <input
              id="er-project"
              class="wb-input"
              type="text"
              placeholder="例如：PJ-141（留空则不填）"
            />
          </div>
        </div>
        <div class="wb-field">
          <label class="wb-label" for="er-symptom">1. 症状 symptom（≥8 字）</label>
          <input id="er-symptom" class="wb-input" type="text" placeholder="可观测到的报错现象或异常行为（至少 8 个字符）" />
        </div>
        <div class="wb-field">
          <label class="wb-label" for="er-context">2. 触发上下文 context（≥8 字）</label>
          <input id="er-context" class="wb-input" type="text" placeholder="运行环境、前置操作与重现条件（至少 8 个字符）" />
        </div>
        <div class="wb-field">
          <label class="wb-label" for="er-root-cause">3. 根本原因 root_cause（≥8 字）</label>
          <input id="er-root-cause" class="wb-input" type="text" placeholder="导致问题的底层机制原因而非表象（至少 8 个字符）" />
        </div>
        <div class="wb-field">
          <label class="wb-label" for="er-fix">4. 修复方案 fix（≥8 字）</label>
          <input id="er-fix" class="wb-input" type="text" placeholder="实际采取并验证有效的修复措施（至少 8 个字符）" />
        </div>
        <div class="wb-field">
          <label class="wb-label" for="er-prevention">5. 预防措施 prevention（≥8 字）</label>
          <input id="er-prevention" class="wb-input" type="text" placeholder="后续自动化门禁或检查清单防重犯机制（至少 8 个字符）" />
        </div>
      </fieldset>

      <!-- 类型专属字段：project -->
      <fieldset class="wb-fieldset" data-type-group="project" hidden>
        <legend class="wb-fieldset__legend">项目专属字段（C-6）</legend>
        <div class="wb-grid wb-grid--2">
          <div class="wb-field">
            <label class="wb-label" for="pj-status">项目状态 status</label>
            <select id="pj-status" class="wb-select">
              <option value="active">active（进行中）</option>
              <option value="shipped">shipped（已上线）</option>
              <option value="idea">idea（构想）</option>
              <option value="paused">paused（暂停）</option>
              <option value="archived">archived（归档）</option>
            </select>
          </div>
          <div class="wb-field">
            <label class="wb-label" for="pj-role">承担角色 role（必填）</label>
            <input id="pj-role" class="wb-input" type="text" placeholder="例如：主架构与独立开发者" />
          </div>
        </div>
        <div class="wb-grid wb-grid--2">
          <div class="wb-field">
            <label class="wb-label" for="pj-start">起始月份 period.start（YYYY-MM）</label>
            <input id="pj-start" class="wb-input" type="month" />
          </div>
          <div class="wb-field">
