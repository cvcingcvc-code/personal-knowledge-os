      <!-- 前端实时 V-010 敏感信息拦截雷达 -->
      <div class="wb-alert wb-alert--ok" id="v010-radar" role="status" aria-live="polite">
        V-010 敏感信息预检通过：未检测到邮箱、手机号、身份证号、API 密钥或私钥块。
      </div>

      <!-- 契约必填项校验提示 -->
      <div class="wb-alert wb-alert--info" id="st-contract-status" role="status" aria-live="polite" hidden></div>

      <!-- 实时路径与 Markdown 预览 -->
      <div class="wb-preview-box">
        <div class="wb-preview-box__head">
          <span class="wb-path-bar">
            推导目标路径：<code id="st-path-preview">staged/knowledge/kb-eng-007-dual-repo-capture.md</code>
          </span>
          <div class="wb-preview-box__tools">
            <button type="button" class="wb-btn wb-btn--secondary wb-btn--sm" id="btn-copy-md">
              复制 Markdown
            </button>
            <button type="button" class="wb-btn wb-btn--secondary wb-btn--sm" id="btn-download-md">
              下载 .md
            </button>
          </div>
        </div>
        <pre class="wb-preview"><code id="st-md-preview"></code></pre>
      </div>

      <!-- 提交与跨仓同步动作 -->
      <div class="wb-actions">
        <button type="button" class="wb-btn wb-btn--primary" id="btn-save-staged">
          存入私有库 staged/ 待同步
        </button>
        <button type="button" class="wb-btn wb-btn--secondary" id="btn-dispatch-sync">
          一键触发同步 PR 至公开知识站
        </button>
      </div>

      <div class="wb-alert" id="struct-result" role="status" aria-live="polite" hidden></div>
    </section>
  </div>

  <!-- Obsidian 浮动智能补全弹窗 (Wikilinks [[ 与 #Tags) -->
  <div class="obsidian-popover" id="obsidian-popover" hidden>
    <div class="obsidian-popover__head">
      <span id="popover-tip">智能建议</span>
      <span class="wb-hint">↑↓选择 · Enter/点击插入 · Esc关闭</span>
    </div>
    <ul class="obsidian-popover__list" id="popover-list" role="listbox"></ul>
  </div>
</Base>

<script is:inline>
  (function () {
    var STORAGE_CONN_KEY = "pko_capture_conn_v1";
    var STORAGE_QUICK_KEY = "pko_capture_quick_draft_v1";
    var STORAGE_STRUCT_KEY = "pko_capture_struct_draft_v1";

    var CONTROLLED_TAGS_LIST = [
      "git", "testing", "debugging", "ci-cd", "architecture", "typescript", "javascript", "python", "node", "sql",
      "performance", "security", "refactoring", "tooling", "windows",
      "requirement", "scope", "roadmap", "user-research", "tradeoff", "mvp",
      "layout", "typography", "accessibility", "responsive", "color",
      "metric", "visualization", "statistics", "data-modeling",
      "budget", "investing", "pricing",
      "english", "writing", "speaking", "vocabulary",
      "sleep", "exercise", "energy",
      "habit", "routine", "travel",
      "learning", "review", "mental-model", "agent-collaboration", "decision-making", "note-taking",
      "workflow", "documentation", "automation", "knowledge-base"
    ];

    var ALL_KNOWLEDGE_ENTRIES = [
      { id: "KB-ENG-003", title: "工作区隔离与多 Agent 并行演进实践", type: "knowledge" },
      { id: "KB-ENG-004", title: "双轨许可设计与代码内容权益隔离实践", type: "knowledge" },
      { id: "KB-ENG-005", title: "低熵架构设计：契约冻结与防腐层实践", type: "knowledge" },
      { id: "KB-ENG-006", title: "Astro 5 项目子路径部署与 Pagefind 归一化实践", type: "knowledge" },
      { id: "PJ-PKOS", title: "Personal Knowledge OS 开源知识操作系统", type: "project" },
      { id: "DJ-2026-11-18", title: "双库在线思考捕获架构演进复盘", type: "journal" },
      { id: "ER-20261114-01", title: "隐私扫描与合成测试凭据零泄漏防御", type: "error" }
    ];

    var DOMAIN_CODES = {
      engineering: "ENG",
      product: "PRD",
      design: "DSN",
      data: "DAT",
      finance: "FIN",
      language: "LNG",
      health: "HLT",
      life: "LIF",
      meta: "MET",
    };

    // 构造同源 V-010 敏感检测规则（采用片段运行时拼装，避免静态产物本身混入敏感特征串）
    var atChar = String.fromCharCode(64);
    var pkMarker = ["PRI", "VATE"].join("") + " " + ["KE", "Y"].join("");
    var skPrefix = ["s", "k", "-"].join("");
    var ghPrefix = ["g", "h"].join("");
    var ghPatPrefix = ["git", "hub", "_", "pat", "_"].join("");
    var akPrefix = ["AK", "IA"].join("");
    var awsSecPrefix = ["AWS", "SECRET", "ACCESS", "KEY"].join("_");

    var V010_RULES = [
      {
        label: "邮箱地址",
        re: new RegExp(
          "[A-Za-z0-9._%+-]+" + atChar + "[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)*\\.[A-Za-z]{2,}"
        ),
      },
      {
        label: "中国大陆手机号",
        re: new RegExp("(?:^|[^0-9])1[3-9][0-9]{9}(?![0-9])"),
      },
      {
        label: "居民身份证号",
        re: new RegExp("(?:^|[^0-9])[0-9]{17}[0-9Xx](?![0-9])"),
      },
      {
        label: "OpenAI 风格密钥",
        re: new RegExp("\\b" + skPrefix + "[A-Za-z0-9_-]{16,}"),
      },
      {
        label: "GitHub 个人访问令牌",
        re: new RegExp(
          "\\b(?:" + ghPrefix + "[pousr]_[A-Za-z0-9]{20,}|" + ghPatPrefix + "[A-Za-z0-9_]{20,})"
        ),
      },
      {
        label: "AWS 访问密钥",
        re: new RegExp(
          "(?:\\b" + akPrefix + "[0-9A-Z]{16}\\b|" + awsSecPrefix + "\\s*=\\s*[\"']?[A-Za-z0-9/+=]{16,})"
        ),
      },
      {
        label: "私钥块",
        re: new RegExp("-----BEGIN (?:[A-Z ]*?)?" + pkMarker + "-----"),
      },
    ];

    function byId(id) {
      return document.getElementById(id);
    }

    function pad2(n) {
      return n < 10 ? "0" + n : String(n);
    }

    function localDateISO(d) {
      var dt = d || new Date();
      return dt.getFullYear() + "-" + pad2(dt.getMonth() + 1) + "-" + pad2(dt.getDate());
    }

    function localMonthISO(d) {
      var dt = d || new Date();
      return dt.getFullYear() + "-" + pad2(dt.getMonth() + 1);
    }

    function localTimestampCompact(d) {
      var dt = d || new Date();
      return (
        localDateISO(dt) +
        "-" +
        pad2(dt.getHours()) +
        pad2(dt.getMinutes()) +
        pad2(dt.getSeconds())
      );
    }

    function localOffsetISO(d) {
      var dt = d || new Date();
      var off = -dt.getTimezoneOffset();
      var sign = off >= 0 ? "+" : "-";
      var abs = Math.abs(off);
      return (
        localDateISO(dt) +
        "T" +
        pad2(dt.getHours()) +
        ":" +
        pad2(dt.getMinutes()) +
        ":" +
        pad2(dt.getSeconds()) +
        sign +
        pad2(Math.floor(abs / 60)) +
        ":" +
        pad2(abs % 60)
      );
    }

    function slugify(input, fallback) {
      var s = String(input || "")
        .toLowerCase()
        .replace(/[^a-z0-9-]+/g, "-")
        .replace(/-+/g, "-")
        .replace(/^-|-$/g, "")
        .slice(0, 48);
      return s || fallback || "note";
    }

    function parseTags(raw) {
      return String(raw || "")
        .split(",")
        .map(function (t) {
          return t
            .trim()
            .toLowerCase()
            .replace(/[^a-z0-9-]+/g, "-")
            .replace(/-+/g, "-")
            .replace(/^-|-$/g, "");
        })
        .filter(function (t) {
          return t.length >= 2 && t.length <= 24;
        })
        .slice(0, 12);
    }

    function parseLines(raw) {
      return String(raw || "")
        .split(/\r?\n/)
        .map(function (line) {
          return line.replace(/^\s*[-*•]\s*/, "").trim();
        })
        .filter(Boolean);
    }

    // ---- Obsidian 风格 Markdown 原生轻量渲染器 ----
    function escapeHtml(str) {
      return String(str || "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
    }

    function renderMarkdown(src) {
      if (!src || !src.trim()) {
        return '<p class="wb-hint" style="font-style:italic;">暂无内容，在左侧输入以实时预览……</p>';
      }
      var lines = src.split(/\r?\n/);
      var html = [];
      var inCode = false;
      var codeBuf = [];
      var inList = false;
      var listType = "ul";

      function closeList() {
        if (inList) {
          html.push(listType === "ul" ? "</ul>" : "</ol>");
          inList = false;
        }
      }

      function inlineFormat(text) {
        var escaped = escapeHtml(text);
        // 1. Obsidian 双向链接 [[ID|Title]] 或 [[ID]]
        escaped = escaped.replace(/\[\[([A-Za-z0-9-_]+)(?:\|([^\]]+))?\]\]/g, function (_, id, title) {
          var display = title ? title.trim() : id;
          return '<span class="obsidian-wikilink"><span class="wikilink-icon">🔗</span> <span class="wikilink-title">' +
            display + '</span> <span class="wikilink-id">(' + id + ')</span></span>';
        });
        // 2. 标签 #tag-name
        escaped = escaped.replace(/(^|\s)#([a-z0-9]+(?:-[a-z0-9]+)*)/gi, function (_, prefix, tag) {
          return prefix + '<span class="obsidian-tag">#' + tag + '</span>';
        });
        // 3. 行内代码 `code`
        escaped = escaped.replace(/`([^`]+)`/g, "<code>$1</code>");
        // 4. 粗体 **bold**
        escaped = escaped.replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>");
        // 5. 斜体 *italic*
        escaped = escaped.replace(/\*([^*]+)\*/g, "<em>$1</em>");
        // 6. 链接 [text](url)
        escaped = escaped.replace(/\[([^\]]+)\]\(([^)]+)\)/g, function (_, label, url) {
          var safeUrl = url.trim();
          if (/^(javascript:|data:)/i.test(safeUrl)) safeUrl = "#";
          return '<a href="' + safeUrl + '" target="_blank" rel="noopener noreferrer">' + label + "</a>";
        });
        return escaped;
      }

      for (var i = 0; i < lines.length; i++) {
        var line = lines[i];

        // 代码块判定 ```
        if (/^```(\w*)/.test(line)) {
          if (inCode) {
            html.push("<pre><code>" + escapeHtml(codeBuf.join("\n")) + "</code></pre>");
            codeBuf = [];
            inCode = false;
          } else {
            closeList();
            inCode = true;
          }
          continue;
        }
        if (inCode) {
          codeBuf.push(line);
          continue;
        }

        // 空行
        if (!line.trim()) {
          closeList();
          continue;
        }

        // 标题 # .. ######
        var headMatch = line.match(/^(#{1,6})\s+(.*)$/);
        if (headMatch) {
          closeList();
          var level = headMatch[1].length;
          html.push("<h" + level + ">" + inlineFormat(headMatch[2]) + "</h" + level + ">");
          continue;
        }

        // 引用 >
        var quoteMatch = line.match(/^>\s?(.*)$/);
        if (quoteMatch) {
          closeList();
          html.push("<blockquote>" + inlineFormat(quoteMatch[1]) + "</blockquote>");
          continue;
        }

        // 待办清单 - [ ] 或 - [x]
        var taskMatch = line.match(/^[-*]\s+\[([ xX])\]\s+(.*)$/);
        if (taskMatch) {
          if (!inList || listType !== "ul") {
            closeList();
            html.push('<ul class="obsidian-task-list" style="list-style:none;padding-left:0;">');
            inList = true;
            listType = "ul";
          }
          var checked = taskMatch[1].toLowerCase() === "x" ? "checked disabled" : "disabled";
          html.push('<li><input type="checkbox" ' + checked + " /> " + inlineFormat(taskMatch[2]) + "</li>");
          continue;
        }

        // 无序列表 - 或 *
        var ulMatch = line.match(/^[-*]\s+(.*)$/);
        if (ulMatch) {
          if (!inList || listType !== "ul") {
            closeList();
            html.push("<ul>");
            inList = true;
            listType = "ul";
          }
          html.push("<li>" + inlineFormat(ulMatch[1]) + "</li>");
          continue;
        }

        // 有序列表 1. 2.
        var olMatch = line.match(/^(\d+)\.\s+(.*)$/);
        if (olMatch) {
          if (!inList || listType !== "ol") {
            closeList();
            html.push("<ol>");
            inList = true;
            listType = "ol";
          }
          html.push("<li>" + inlineFormat(olMatch[2]) + "</li>");
          continue;
        }

        // 普通段落
        closeList();
        html.push("<p>" + inlineFormat(line) + "</p>");
      }

      closeList();
      if (inCode) {
        html.push("<pre><code>" + escapeHtml(codeBuf.join("\n")) + "</code></pre>");
      }

      return html.join("\n");
    }

    function yamlStr(val) {
      return JSON.stringify(String(val == null ? "" : val));
    }

    function yamlStrArray(items) {
      if (!items || items.length === 0) return "[]";
      return (
        "\n" +
        items
          .map(function (item) {
            return "  - " + yamlStr(item);
          })
          .join("\n")
      );
    }

    function utf8ToBase64(text) {
      var bytes = new TextEncoder().encode(text);
      var chunkSize = 8192;
      var binary = "";
      for (var i = 0; i < bytes.length; i += chunkSize) {
        var sub = bytes.subarray(i, i + chunkSize);
        binary += String.fromCharCode.apply(null, Array.from(sub));
      }
      return btoa(binary);
    }

    function encodeRepoPath(repoPath) {
      return String(repoPath || "")
        .split("/")
        .filter(Boolean)
        .map(encodeURIComponent)
        .join("/");
    }

    function parseRepoSlug(raw) {
      var trimmed = String(raw || "").trim().replace(/^\/+|\/+$/g, "");
      if (!/^[A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+$/.test(trimmed)) return null;
      var parts = trimmed.split("/");
      return {
        full: trimmed,
        owner: parts[0],
        repo: parts[1],
        encoded: encodeURIComponent(parts[0]) + "/" + encodeURIComponent(parts[1]),
      };
    }

    function setAlert(el, kind, text, linkInfo) {
      if (!el) return;
      el.hidden = false;
      el.className = "wb-alert wb-alert--" + kind;
      el.textContent = "";
      var span = document.createElement("span");
      span.textContent = text;
      el.appendChild(span);
      if (linkInfo && linkInfo.url) {
        var sep = document.createTextNode(" ");
        var a = document.createElement("a");
        a.href = linkInfo.url;
        a.target = "_blank";
        a.rel = "noopener noreferrer";
        a.textContent = linkInfo.label || linkInfo.url;
        el.appendChild(sep);
        el.appendChild(a);
      }
    }

    // ---- 连接状态与防呆保护 ----
    var connDetails = byId("wb-settings");
    var cfgRepo = byId("cfg-repo");
    var cfgBranch = byId("cfg-branch");
    var cfgToken = byId("cfg-token");
    var connBadge = byId("conn-badge");
    var connStatus = byId("conn-status");
    var btnVerifyConn = byId("btn-verify-conn");
    var btnClearConn = byId("btn-clear-conn");
    var btnSaveInbox = byId("btn-save-inbox");
    var btnSaveStaged = byId("btn-save-staged");
    var btnDispatchSync = byId("btn-dispatch-sync");

    // verifiedPrivateRepo 记录已通过 private===true 校验的 repo slug；blockedPublic 标记是否触发公开库阻断
    var verifiedPrivateRepo = null;
    var blockedPublic = false;
    var v010Blocked = false;

    function syncWriteButtonsState() {
      if (btnSaveInbox) {
        btnSaveInbox.disabled = blockedPublic;
      }
      if (btnSaveStaged) {
        btnSaveStaged.disabled = blockedPublic || v010Blocked;
      }
      if (btnDispatchSync) {
        btnDispatchSync.disabled = blockedPublic;
      }
    }

    function setBadge(text, variant) {
      if (!connBadge) return;
      connBadge.textContent = text;
      connBadge.className = "badge" + (variant ? " " + variant : "");
    }

    function loadSavedConn() {
      try {
        var raw = localStorage.getItem(STORAGE_CONN_KEY);
        if (!raw) return;
        var data = JSON.parse(raw);
        if (data && typeof data === "object") {
          if (data.repo && cfgRepo) cfgRepo.value = String(data.repo);
          if (data.branch && cfgBranch) cfgBranch.value = String(data.branch);
          if (data.token && cfgToken) {
            cfgToken.value = String(data.token);
            setBadge("已载入本机令牌（待校验）", "badge--kind");
            if (connDetails) connDetails.open = false;
          }
        }
      } catch (_e) {
        // 忽略损坏的本地存储
      }
    }

    // 修改目标仓库或令牌时重置校验缓存
    [cfgRepo, cfgToken].forEach(function (inp) {
      if (!inp) return;
      inp.addEventListener("input", function () {
        verifiedPrivateRepo = null;
        blockedPublic = false;
        syncWriteButtonsState();
      });
    });

    async function verifyPrivateRepo(saveOnSuccess) {
      var parsed = parseRepoSlug(cfgRepo && cfgRepo.value);
      var branch = String((cfgBranch && cfgBranch.value) || "main").trim() || "main";
      var token = String((cfgToken && cfgToken.value) || "").trim();

      if (!parsed) {
        setAlert(connStatus, "danger", "仓库格式错误：请填写 owner/repo（例如 cvcingcvc-code/personal-knowledge-vault）。");
        return null;
      }
      if (!token) {
        if (connDetails) connDetails.open = true;
        setAlert(connStatus, "danger", "请先在「私有库连接设置」中粘贴 Fine-Grained Token。");
        return null;
      }

      setBadge("正在验证连接…", "");
      setAlert(connStatus, "info", "正在连接 GitHub API 校验仓库私有属性…");

      try {
        var res = await fetch("https://api.github.com/repos/" + parsed.encoded, {
          method: "GET",
          headers: {
            Authorization: "Bearer " + token,
            Accept: "application/vnd.github+json",
            "X-GitHub-Api-Version": "2022-11-28",
          },
        });

        if (!res.ok) {
          verifiedPrivateRepo = null;
          blockedPublic = false;
          syncWriteButtonsState();
          setBadge("连接校验未通过", "badge--warn");
          var hint =
            res.status === 401
              ? "令牌无效或已过期（HTTP 401），请检查并重新生成 Fine-Grained Token。"
              : res.status === 404
                ? "无法访问目标仓库（HTTP 404）：请确认私有仓库已建立，且该令牌已授权访问此仓库。"
                : "GitHub API 返回异常状态（HTTP " + res.status + "）。";
          setAlert(connStatus, "danger", hint);
          return null;
        }

        var repoData = await res.json();
        if (repoData.private !== true) {
          verifiedPrivateRepo = null;
          blockedPublic = true;
          syncWriteButtonsState();
          if (connDetails) connDetails.open = true;
          setBadge("已阻断：非私有库", "badge--warn");
          setAlert(
            connStatus,
            "danger",
            "安全阻断：目标仓库不是 Private 私有仓库！拒绝向公开仓库直接写入原始思考。"
          );
          return null;
        }

        // Private === true 校验通过
        blockedPublic = false;
        verifiedPrivateRepo = repoData.full_name || parsed.full;
        syncWriteButtonsState();
        setBadge("Private 私有库已连接", "badge--status-verified");
        setAlert(
          connStatus,
          "ok",
          "已连接私有仓库 " + verifiedPrivateRepo + "（Private 校验通过）"
        );

        if (saveOnSuccess) {
          try {
            localStorage.setItem(
              STORAGE_CONN_KEY,
              JSON.stringify({ repo: parsed.full, branch: branch, token: token })
            );
          } catch (_e) {
            // 忽略隐私无痕窗口配额限制
          }
        }

        return { parsed: parsed, branch: branch, token: token, fullName: verifiedPrivateRepo };
      } catch (_err) {
        verifiedPrivateRepo = null;
        setBadge("网络请求失败", "badge--warn");
        setAlert(connStatus, "danger", "无法连接 api.github.com，请检查当前网络环境后重试。");
        return null;
      }
    }

    async function ensureVerifiedConn() {
      var parsed = parseRepoSlug(cfgRepo && cfgRepo.value);
      var branch = String((cfgBranch && cfgBranch.value) || "main").trim() || "main";
      var token = String((cfgToken && cfgToken.value) || "").trim();
      if (!parsed || !token) {
        return verifyPrivateRepo(false);
      }
      if (blockedPublic) {
        if (connDetails) connDetails.open = true;
        return null;
      }
      if (verifiedPrivateRepo && verifiedPrivateRepo.toLowerCase() === parsed.full.toLowerCase()) {
        return { parsed: parsed, branch: branch, token: token, fullName: verifiedPrivateRepo };
      }
      return verifyPrivateRepo(true);
    }

    if (btnVerifyConn) {
      btnVerifyConn.addEventListener("click", function () {
        verifyPrivateRepo(true);
      });
    }

    if (btnClearConn) {
      btnClearConn.addEventListener("click", function () {
        try {
          localStorage.removeItem(STORAGE_CONN_KEY);
        } catch (_e) {}
        if (cfgToken) cfgToken.value = "";
        verifiedPrivateRepo = null;
        blockedPublic = false;
        syncWriteButtonsState();
        setBadge("未配置本机令牌", "");
        setAlert(connStatus, "info", "已清除保存在本机浏览器中的令牌。");
      });
    }

    // ---- Tabs 切换 ----
    var tabQuick = byId("tab-btn-quick");
    var tabStruct = byId("tab-btn-struct");
    var panelQuick = byId("panel-quick");
    var panelStruct = byId("panel-struct");

    function switchTab(mode) {
      var isQuick = mode === "quick";
      if (tabQuick) {
        tabQuick.setAttribute("aria-selected", isQuick ? "true" : "false");
        tabQuick.classList.toggle("is-active", isQuick);
      }
      if (tabStruct) {
        tabStruct.setAttribute("aria-selected", isQuick ? "false" : "true");
        tabStruct.classList.toggle("is-active", !isQuick);
      }
      if (panelQuick) panelQuick.hidden = !isQuick;
      if (panelStruct) panelStruct.hidden = isQuick;
      if (!isQuick) refreshStructuredPreview();
    }

    if (tabQuick) {
      tabQuick.addEventListener("click", function () {
        switchTab("quick");
      });
    }
    if (tabStruct) {
      tabStruct.addEventListener("click", function () {
        switchTab("struct");
      });
    }

    // ---- Tab 1：快速思考（直存私有库 inbox/） ----
    var quickTitle = byId("quick-title");
    var quickBody = byId("quick-body");
    var quickTags = byId("quick-tags");
    var quickDraftNote = byId("quick-draft-note");
    var quickPathPreview = byId("quick-path-preview");
    var btnClearQuick = byId("btn-clear-quick");
    var quickResult = byId("quick-result");

    // Obsidian 增强组件引用
    var btnQuickTimestamp = byId("btn-quick-timestamp");
    var quickPreviewPane = byId("quick-preview-pane");
    var quickWordCount = byId("quick-word-count");
    var quickAutosaveIndicator = byId("quick-autosave-indicator");
    var quickEditorWrap = byId("quick-editor-wrap");

    var structPreviewPane = byId("struct-preview-pane");
    var structWordCount = byId("struct-word-count");
    var structAutosaveIndicator = byId("struct-autosave-indicator");
    var structEditorWrap = byId("struct-editor-wrap");

    var obsidianPopover = byId("obsidian-popover");
    var popoverList = byId("popover-list");
    var popoverTip = byId("popover-tip");

    function computeQuickMeta(now) {
      var dt = now || new Date();
      var year = String(dt.getFullYear());
      var ts = localTimestampCompact(dt);
      var rawTitle = String((quickTitle && quickTitle.value) || "").trim();
      var finalTitle =
        rawTitle ||
        "思考记录 " +
          localDateISO(dt) +
          " " +
          pad2(dt.getHours()) +
          ":" +
          pad2(dt.getMinutes());
      var slug = slugify(rawTitle, "thought");
      var path = "inbox/" + year + "/" + ts + "-" + slug + ".md";
      return { dt: dt, title: finalTitle, path: path };
    }

    function updateQuickPreviewAndCache(saveDraft) {
      var meta = computeQuickMeta(new Date());
      if (quickPathPreview) quickPathPreview.textContent = meta.path;
      var text = (quickBody && quickBody.value) || "";
      if (quickPreviewPane) {
        quickPreviewPane.innerHTML = renderMarkdown(text);
      }
      if (quickWordCount) {
        quickWordCount.textContent = text.trim().length + " 字";
      }

      if (saveDraft) {
        try {
          localStorage.setItem(
            STORAGE_QUICK_KEY,
            JSON.stringify({
              title: (quickTitle && quickTitle.value) || "",
              body: text,
              tags: (quickTags && quickTags.value) || "",
            })
          );
          var timeStr = pad2(meta.dt.getHours()) + ":" + pad2(meta.dt.getMinutes());
          if (quickDraftNote) {
            quickDraftNote.textContent = "本地草稿已暂存（" + timeStr + "）";
          }
          if (quickAutosaveIndicator) {
            quickAutosaveIndicator.textContent = "● 草稿已暂存 (" + timeStr + ")";
            quickAutosaveIndicator.classList.add("is-saved");
          }
        } catch (_e) {}
      }
    }

    function loadQuickDraft() {
      try {
        var raw = localStorage.getItem(STORAGE_QUICK_KEY);
        if (!raw) return;
        var d = JSON.parse(raw);
        if (d && typeof d === "object") {
          if (d.title && quickTitle) quickTitle.value = String(d.title);
          if (d.body && quickBody) quickBody.value = String(d.body);
          if (d.tags && quickTags) quickTags.value = String(d.tags);
          if ((d.title || d.body || d.tags) && quickDraftNote) {
            quickDraftNote.textContent = "已恢复上次未提交的本地草稿";
          }
        }
      } catch (_e) {}
    }

    [quickTitle, quickBody, quickTags].forEach(function (el) {
      if (!el) return;
      el.addEventListener("input", function () {
        updateQuickPreviewAndCache(true);
      });
    });

    if (btnQuickTimestamp) {
      btnQuickTimestamp.addEventListener("click", function () {
        var now = new Date();
        var timeStr = pad2(now.getHours()) + ":" + pad2(now.getMinutes());
        if (quickTitle && !quickTitle.value.trim()) {
          quickTitle.value = localDateISO(now) + " 闪念";
        }
        var stamp = "\n\n### " + timeStr + "\n\n- ";
        if (quickBody) {
          if (!quickBody.value.trim()) {
            quickBody.value = "### " + timeStr + "\n\n- ";
          } else {
            quickBody.value = quickBody.value.replace(/\s*$/, "") + stamp;
          }
          quickBody.focus();
          quickBody.setSelectionRange(quickBody.value.length, quickBody.value.length);
        }
        updateQuickPreviewAndCache(true);
      });
    }

    if (btnClearQuick) {
      btnClearQuick.addEventListener("click", function () {
        if (quickTitle) quickTitle.value = "";
        if (quickBody) quickBody.value = "";
        if (quickTags) quickTags.value = "";
        try {
          localStorage.removeItem(STORAGE_QUICK_KEY);
        } catch (_e) {}
        if (quickDraftNote) quickDraftNote.textContent = "草稿已清空";
        updateQuickPreviewAndCache(false);
      });
    }

    if (btnSaveInbox) {
      btnSaveInbox.addEventListener("click", async function () {
        var bodyText = String((quickBody && quickBody.value) || "").trim();
        if (!bodyText) {
          setAlert(quickResult, "danger", "思考正文不能为空，请先输入内容。");
          if (quickBody) quickBody.focus();
          return;
        }

        var conn = await ensureVerifiedConn();
        if (!conn) {
          setAlert(
            quickResult,
            "danger",
            blockedPublic
              ? "安全阻断：目标仓库不是 Private 私有仓库，已禁止写入！"
              : "连接未就绪：请先在上方「私有库连接设置」保存并验证有效令牌。"
          );
          return;
        }

        var now = new Date();
        var meta = computeQuickMeta(now);
        var tags = parseTags(quickTags && quickTags.value);
        var tagsYaml =
          tags.length === 0
            ? "[]"
            : "[" + tags.map(yamlStr).join(", ") + "]";
        var md =
          [
            "---",
            "title: " + yamlStr(meta.title),
            "captured_at: " + yamlStr(localOffsetISO(now)),
            "tags: " + tagsYaml,
            "privacy_level: L3",
            "---",
            "",
            bodyText,
            "",
          ].join("\n");

        btnSaveInbox.disabled = true;
        setAlert(quickResult, "info", "正在加密传输并写入私有库 " + meta.path + " …");

        try {
          var apiUrl =
            "https://api.github.com/repos/" +
            conn.parsed.encoded +
            "/contents/" +
            encodeRepoPath(meta.path);
          var res = await fetch(apiUrl, {
            method: "PUT",
            headers: {
              Authorization: "Bearer " + conn.token,
              Accept: "application/vnd.github+json",
              "Content-Type": "application/json",
              "X-GitHub-Api-Version": "2022-11-28",
            },
            body: JSON.stringify({
              message: "capture(inbox): " + meta.title,
              content: utf8ToBase64(md),
              branch: conn.branch,
            }),
          });

          if (!res.ok) {
            var errText = "写入失败（HTTP " + res.status + "）：请确认令牌具备该私有库 Contents 读写权限且分支存在。";
            setAlert(quickResult, "danger", errText);
            syncWriteButtonsState();
            return;
          }

          var out = await res.json();
          var fileUrl =
            (out && out.content && out.content.html_url) ||
            "https://github.com/" +
              conn.parsed.full +
              "/blob/" +
              encodeURIComponent(conn.branch) +
              "/" +
              meta.path;

          // 成功后清空输入框与本地草稿缓存
          if (quickTitle) quickTitle.value = "";
          if (quickBody) quickBody.value = "";
          if (quickTags) quickTags.value = "";
          try {
            localStorage.removeItem(STORAGE_QUICK_KEY);
          } catch (_e) {}
          if (quickDraftNote) quickDraftNote.textContent = "已存入私有库，本机草稿已清空";
          updateQuickPreviewAndCache(false);

          setAlert(quickResult, "ok", "已成功存入私有仓库：", {
            url: fileUrl,
            label: meta.path + " ↗",
          });
        } catch (_e) {
          setAlert(quickResult, "danger", "网络请求异常，本机草稿已保留，请稍后重试。");
        } finally {
          syncWriteButtonsState();
        }
      });
    }

    // ---- Tab 2：结构化沉淀（脱敏草稿 → staged/ + V-010 实时雷达） ----
    var stType = byId("st-type");
    var stId = byId("st-id");
    var stSlugWrap = byId("st-slug-wrap");
    var stSlug = byId("st-slug");
    var stTitle = byId("st-title");
    var stSummary = byId("st-summary");
    var stSummaryCount = byId("st-summary-count");
    var stTags = byId("st-tags");
    var stVaultRef = byId("st-vault-ref");
    var stBody = byId("st-body");

    var kbDomain = byId("kb-domain");
    var kbStatus = byId("kb-status");
    var kbConfidence = byId("kb-confidence");
    var kbSourceKind = byId("kb-source-kind");
    var kbSourceRef = byId("kb-source-ref");
    var kbSourceLocator = byId("kb-source-locator");

    var djDate = byId("dj-date");
    var djEnergy = byId("dj-energy");
    var djDid = byId("dj-did");
    var djLearned = byId("dj-learned");
    var djBlocked = byId("dj-blocked");
    var djTomorrow = byId("dj-tomorrow");

    var erOccurred = byId("er-occurred");
    var erSeverity = byId("er-severity");
    var erProject = byId("er-project");
    var erSymptom = byId("er-symptom");
    var erContext = byId("er-context");
    var erRootCause = byId("er-root-cause");
    var erFix = byId("er-fix");
    var erPrevention = byId("er-prevention");

    var pjStatus = byId("pj-status");
    var pjRole = byId("pj-role");
    var pjStart = byId("pj-start");
    var pjEnd = byId("pj-end");
    var pjStack = byId("pj-stack");
    var pjOutcomes = byId("pj-outcomes");

    var v010Radar = byId("v010-radar");
    var stContractStatus = byId("st-contract-status");
    var stPathPreview = byId("st-path-preview");
    var stMdPreview = byId("st-md-preview");
    var btnCopyMd = byId("btn-copy-md");
    var btnDownloadMd = byId("btn-download-md");
    var structResult = byId("struct-result");

    // 初始化默认日期
    var todayStr = localDateISO(new Date());
    var monthStr = localMonthISO(new Date());
    if (djDate && !djDate.value) djDate.value = todayStr;
    if (erOccurred && !erOccurred.value) erOccurred.value = todayStr;
    if (pjStart && !pjStart.value) pjStart.value = monthStr;

    function suggestIdForType(t) {
      if (t === "knowledge") {
        var dom = (kbDomain && kbDomain.value) || "engineering";
        var code = DOMAIN_CODES[dom] || "ENG";
        return "KB-" + code + "-007";
      }
      if (t === "journal") {
        var d = (djDate && djDate.value) || todayStr;
        return "DJ-" + d;
      }
      if (t === "error") {
        var occ = ((erOccurred && erOccurred.value) || todayStr).replace(/-/g, "");
        return "ER-" + occ + "-01";
      }
      return "PJ-V02";
    }

    function syncTypeVisibility() {
      var t = (stType && stType.value) || "knowledge";
      var groups = document.querySelectorAll("[data-type-group]");
      groups.forEach(function (g) {
        g.hidden = g.getAttribute("data-type-group") !== t;
      });
      if (stSlugWrap) {
        stSlugWrap.hidden = t === "journal";
      }
      if (stId) {
        stId.readOnly = t === "journal";
        stId.value = suggestIdForType(t);
      }
      refreshStructuredPreview();
    }

    if (stType) {
      stType.addEventListener("change", syncTypeVisibility);
    }

    if (kbDomain) {
      kbDomain.addEventListener("change", function () {
        if (stType && stType.value === "knowledge" && stId) {
          var code = DOMAIN_CODES[kbDomain.value] || "ENG";
          var m = /^KB-[A-Z]{2,6}-(\d{3})$/.exec(stId.value.trim());
          stId.value = "KB-" + code + "-" + (m ? m[1] : "007");
        }
        refreshStructuredPreview();
      });
    }

    if (djDate) {
      djDate.addEventListener("input", function () {
        if (stType && stType.value === "journal" && stId) {
          stId.value = "DJ-" + (djDate.value || todayStr);
        }
        refreshStructuredPreview();
      });
    }

    if (erOccurred) {
      erOccurred.addEventListener("input", function () {
        if (stType && stType.value === "error" && stId) {
          var compact = (erOccurred.value || todayStr).replace(/-/g, "");
          var m = /^ER-\d{8}-(\d{2})$/.exec(stId.value.trim());
          stId.value = "ER-" + compact + "-" + (m ? m[1] : "01");
        }
        refreshStructuredPreview();
      });
    }

    function scanV010(text) {
      var hits = [];
      for (var i = 0; i < V010_RULES.length; i++) {
        if (V010_RULES[i].re.test(text)) {
          hits.push(V010_RULES[i].label);
        }
      }
      return hits;
    }

    function buildStructuredArtifact() {
      var t = (stType && stType.value) || "knowledge";
      var today = localDateISO(new Date());
      var rawId = String((stId && stId.value) || "").trim().toUpperCase();
      if (t === "journal") {
        var jDate = (djDate && djDate.value) || today;
        rawId = "DJ-" + jDate;
      }

      var title = String((stTitle && stTitle.value) || "").trim();
      var summary = String((stSummary && stSummary.value) || "").trim();
      var tags = parseTags(stTags && stTags.value);
      var vaultRef = String((stVaultRef && stVaultRef.value) || "").trim();
      var body = String((stBody && stBody.value) || "").trim();
      var slug = slugify((stSlug && stSlug.value) || title, "draft");

      var issues = [];
      if (title.length < 4 || title.length > 80) {
        issues.push("title 需 4..80 字符（当前 " + title.length + " 字）");
      }
      if (summary.length < 20 || summary.length > 200) {
        issues.push("summary 需 20..200 字符（当前 " + summary.length + " 字）");
      }
      if (vaultRef && !/^vault:(?!\/)(?!.*\.\.)[A-Za-z0-9._\-/]+$/.test(vaultRef)) {
        issues.push("vault_ref 必须形如 vault:inbox/... 相对路径");
      }

      var idPatterns = {
        knowledge: /^KB-[A-Z]{2,6}-\d{3}$/,
        journal: /^DJ-\d{4}-\d{2}-\d{2}$/,
        error: /^ER-\d{8}-\d{2}$/,
        project: /^PJ-[A-Z0-9]{2,8}$/,
      };
      if (!idPatterns[t].test(rawId)) {
        issues.push("id 不符合 C-2 规范（当前 " + (rawId || "空") + "）");
      }

      var targetPath = "";
      var lines = [
        "---",
        "id: " + yamlStr(rawId),
        "type: " + t,
        "title: " + yamlStr(title),
        "summary: " + yamlStr(summary),
        "created: " + today,
        "updated: " + today,
        "published: false",
        "tags: [" + tags.map(yamlStr).join(", ") + "]",
        "sample: false",
        "vault_ref: " + (vaultRef ? yamlStr(vaultRef) : "null"),
      ];

      if (t === "knowledge") {
        var dom = (kbDomain && kbDomain.value) || "engineering";
        var status = (kbStatus && kbStatus.value) || "seed";
        var conf = (kbConfidence && kbConfidence.value) || "medium";
        var sKind = (kbSourceKind && kbSourceKind.value) || "experience";
        var sRef = String((kbSourceRef && kbSourceRef.value) || "").trim();
        var sLoc = String((kbSourceLocator && kbSourceLocator.value) || "").trim();

        var expectedPrefix = "KB-" + (DOMAIN_CODES[dom] || "ENG") + "-";
        if (rawId.indexOf(expectedPrefix) !== 0) {
          issues.push("knowledge id 前缀需匹配领域缩写 " + expectedPrefix);
        }
        if (status === "verified" && !sRef) {
          issues.push("status 为 verified 时必须填写来源引用 source.ref（V-009）");
        }
        if (conf === "high" && (!sRef || sKind === "agent")) {
          issues.push("confidence 为 high 时至少需 1 个非 agent 来源（V-009）");
        }

        lines.push("domain: " + dom);
        lines.push("status: " + status);
        lines.push("confidence: " + conf);
        if (sRef) {
          lines.push("sources:");
          lines.push("  - kind: " + sKind);
          lines.push("    ref: " + yamlStr(sRef));
          if (sLoc) lines.push("    locator: " + yamlStr(sLoc));
          lines.push("    accessed: " + today);
        } else {
          lines.push("sources: []");
        }
        lines.push("related: []");
        targetPath = "staged/knowledge/" + rawId.toLowerCase() + "-" + slug + ".md";
      } else if (t === "journal") {
        var dVal = (djDate && djDate.value) || today;
        var yearSeg = dVal.slice(0, 4);
        var energyVal = (djEnergy && djEnergy.value) || "";
        var didArr = parseLines(djDid && djDid.value);
        var learnedArr = parseLines(djLearned && djLearned.value);
        var blockedArr = parseLines(djBlocked && djBlocked.value);
        var tomorrowArr = parseLines(djTomorrow && djTomorrow.value);

        if (didArr.length === 0) issues.push("did 至少填写 1 项（C-7）");
        if (learnedArr.length === 0) issues.push("learned 至少填写 1 项（C-7）");

        lines.push("date: " + dVal);
        lines.push("review_status: draft");
        lines.push("source: self-reported");
        if (energyVal) lines.push("energy: " + Number(energyVal));
        lines.push("did:" + yamlStrArray(didArr));
        lines.push("learned:" + yamlStrArray(learnedArr));
        lines.push("blocked:" + yamlStrArray(blockedArr));
        lines.push("tomorrow:" + yamlStrArray(tomorrowArr));
        lines.push("linked_knowledge: []");
        lines.push("linked_projects: []");
        lines.push("linked_errors: []");
        targetPath = "staged/journal/" + yearSeg + "/" + dVal + ".md";
      } else if (t === "error") {
        var occDate = (erOccurred && erOccurred.value) || today;
        var sev = (erSeverity && erSeverity.value) || "medium";
        var projId = String((erProject && erProject.value) || "").trim().toUpperCase();
        var sym = String((erSymptom && erSymptom.value) || "").trim();
        var ctx = String((erContext && erContext.value) || "").trim();
        var rc = String((erRootCause && erRootCause.value) || "").trim();
        var fix = String((erFix && erFix.value) || "").trim();
        var prev = String((erPrevention && erPrevention.value) || "").trim();

        var five = [
          ["symptom", sym],
          ["context", ctx],
          ["root_cause", rc],
          ["fix", fix],
          ["prevention", prev],
        ];
        five.forEach(function (pair) {
          if (pair[1].length < 8) {
            issues.push(pair[0] + " 需不少于 8 个字符（V-016）");
          }
        });
        if (projId && !/^PJ-[A-Z0-9]{2,8}$/.test(projId)) {
          issues.push("关联项目 ID 需符合 PJ-* 格式");
        }

        lines.push("occurred: " + occDate);
        lines.push("severity: " + sev);
        lines.push("symptom: " + yamlStr(sym));
        lines.push("context: " + yamlStr(ctx));
        lines.push("root_cause: " + yamlStr(rc));
        lines.push("fix: " + yamlStr(fix));
        lines.push("prevention: " + yamlStr(prev));
        lines.push("evidence: []");
        if (projId) lines.push("project: " + yamlStr(projId));
        targetPath = "staged/errors/" + rawId.toLowerCase() + "-" + slug + ".md";
      } else if (t === "project") {
        var pStat = (pjStatus && pjStatus.value) || "active";
        var role = String((pjRole && pjRole.value) || "").trim();
        var pStart = (pjStart && pjStart.value) || monthStr;
        var pEnd = String((pjEnd && pjEnd.value) || "").trim();
        var stackArr = String((pjStack && pjStack.value) || "")
          .split(",")
          .map(function (s) {
            return s.trim();
          })
          .filter(Boolean);
        var outcomesArr = parseLines(pjOutcomes && pjOutcomes.value);

        if (!role) issues.push("role 承担角色不能为空（C-6）");
        if (!/^\d{4}-\d{2}$/.test(pStart)) issues.push("period.start 需为 YYYY-MM");
        if (pEnd && !/^\d{4}-\d{2}$/.test(pEnd)) issues.push("period.end 需为 YYYY-MM 或留空");
        if (outcomesArr.length === 0) issues.push("outcomes 可验证成果至少填写 1 项（C-6）");

        lines.push("status: " + pStat);
        lines.push("role: " + yamlStr(role));
        lines.push("period:");
        lines.push("  start: " + yamlStr(pStart));
        lines.push("  end: " + (pEnd ? yamlStr(pEnd) : "null"));
        lines.push("stack: [" + stackArr.map(yamlStr).join(", ") + "]");
        lines.push("outcomes:" + yamlStrArray(outcomesArr));
        lines.push("linked_knowledge: []");
        lines.push("linked_errors: []");
        targetPath = "staged/projects/" + rawId.toLowerCase() + "-" + slug + ".md";
      }

      lines.push("---");
      lines.push("");
      lines.push(body || "<!-- 待补充脱敏结构化正文 -->");
      lines.push("");

      var markdown = lines.join("\n");
      var v010Hits = scanV010(markdown);
      return {
        path: targetPath,
        filename: targetPath.split("/").pop() || "draft.md",
        markdown: markdown,
        issues: issues,
        v010Hits: v010Hits,
        summaryLen: summary.length,
      };
    }

    function refreshStructuredPreview() {
      var art = buildStructuredArtifact();
      if (stSummaryCount) {
        stSummaryCount.textContent = art.summaryLen + " / 20..200 字";
      }
      if (stPathPreview) {
        stPathPreview.textContent = art.path;
      }
      if (stMdPreview) {
        stMdPreview.textContent = art.markdown;
      }

      // Obsidian 实时 Markdown 预览与字数统计
      var rawBody = (stBody && stBody.value) || "";
      if (structPreviewPane) {
        structPreviewPane.innerHTML = renderMarkdown(rawBody);
      }
      if (structWordCount) {
        structWordCount.textContent = rawBody.trim().length + " 字";
      }

      // 本地草稿自动保存
      try {
        localStorage.setItem(
          STORAGE_STRUCT_KEY,
          JSON.stringify({
            type: (stType && stType.value) || "knowledge",
            id: (stId && stId.value) || "",
            slug: (stSlug && stSlug.value) || "",
            title: (stTitle && stTitle.value) || "",
            summary: (stSummary && stSummary.value) || "",
            tags: (stTags && stTags.value) || "",
            body: rawBody,
          })
        );
        var now = new Date();
        var timeStr = pad2(now.getHours()) + ":" + pad2(now.getMinutes());
        if (structAutosaveIndicator) {
          structAutosaveIndicator.textContent = "● 草稿已暂存 (" + timeStr + ")";
          structAutosaveIndicator.classList.add("is-saved");
        }
      } catch (_e) {}

      // 更新 V-010 实时雷达
      if (art.v010Hits.length > 0) {
        v010Blocked = true;
        setAlert(
          v010Radar,
          "danger",
          "V-010 敏感信息拦截：检测到疑似【" +
            art.v010Hits.join("、") +
            "】！已禁用存入 staged/。请先脱敏移除敏感内容，或切回「快速思考」仅存入私密 inbox/。"
        );
      } else {
        v010Blocked = false;
        setAlert(
          v010Radar,
          "ok",
          "V-010 敏感信息预检通过：未检测到邮箱、手机号、身份证号、API 密钥或私钥块。"
        );
      }
      syncWriteButtonsState();

      // 更新契约完整性提示
      if (stContractStatus) {
        if (art.issues.length > 0) {
          setAlert(
            stContractStatus,
            "info",
            "待完善契约必填项（存入 staged/ 前需补齐）：" + art.issues.join("；")
          );
        } else {
          stContractStatus.hidden = true;
        }
      }
      return art;
    }

    // 绑定结构化面板全部输入控件实时刷新
    if (panelStruct) {
      panelStruct.addEventListener("input", refreshStructuredPreview);
      panelStruct.addEventListener("change", refreshStructuredPreview);
    }

    // 复制与下载离线可用按钮
    if (btnCopyMd) {
      btnCopyMd.addEventListener("click", async function () {
        var art = refreshStructuredPreview();
        try {
          await navigator.clipboard.writeText(art.markdown);
          setAlert(structResult, "ok", "已复制生成的 Markdown 到剪贴板。");
        } catch (_e) {
          setAlert(structResult, "info", "当前浏览器限制剪贴板自动写入，请直接从预览框手动全选复制。");
        }
      });
    }

    if (btnDownloadMd) {
      btnDownloadMd.addEventListener("click", function () {
        var art = refreshStructuredPreview();
        var blob = new Blob([art.markdown], { type: "text/markdown;charset=utf-8" });
        var url = URL.createObjectURL(blob);
        var a = document.createElement("a");
        a.href = url;
        a.download = art.filename;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
        setAlert(structResult, "ok", "已触发下载文件：" + art.filename);
      });
    }

    // 存入私有库 staged/
    if (btnSaveStaged) {
      btnSaveStaged.addEventListener("click", async function () {
        var art = refreshStructuredPreview();
        if (art.v010Hits.length > 0) {
          setAlert(
            structResult,
            "danger",
            "V-010 拦截生效：内容仍含敏感信息（" + art.v010Hits.join("、") + "），禁止放入 staged/。"
          );
          return;
        }
        if (art.issues.length > 0) {
          setAlert(
            structResult,
            "danger",
            "请先补齐契约必填项后再存入 staged/：" + art.issues.join("；")
          );
          return;
        }

        var conn = await ensureVerifiedConn();
        if (!conn) {
          setAlert(
            structResult,
            "danger",
            blockedPublic
              ? "安全阻断：目标仓库不是 Private 私有仓库，已禁止写入！"
              : "连接未就绪：请先在上方「私有库连接设置」保存并验证有效令牌。"
          );
          return;
        }

        btnSaveStaged.disabled = true;
        setAlert(structResult, "info", "正在写入私有库 " + art.path + " …");

        try {
          var apiUrl =
            "https://api.github.com/repos/" +
            conn.parsed.encoded +
            "/contents/" +
            encodeRepoPath(art.path);

          // 若同名草稿已存在，先取 sha 以支持平滑覆盖更新
          var existingSha = null;
          var checkRes = await fetch(
            apiUrl + "?ref=" + encodeURIComponent(conn.branch),
            {
              method: "GET",
              headers: {
                Authorization: "Bearer " + conn.token,
                Accept: "application/vnd.github+json",
                "X-GitHub-Api-Version": "2022-11-28",
              },
            }
          );
          if (checkRes.ok) {
            var existingData = await checkRes.json();
            if (existingData && existingData.sha) existingSha = existingData.sha;
          }

          var payload = {
            message: "stage(" + ((stType && stType.value) || "content") + "): " + art.filename,
            content: utf8ToBase64(art.markdown),
            branch: conn.branch,
          };
          if (existingSha) payload.sha = existingSha;

          var putRes = await fetch(apiUrl, {
            method: "PUT",
            headers: {
              Authorization: "Bearer " + conn.token,
              Accept: "application/vnd.github+json",
              "Content-Type": "application/json",
              "X-GitHub-Api-Version": "2022-11-28",
            },
            body: JSON.stringify(payload),
          });

          if (!putRes.ok) {
            setAlert(
              structResult,
              "danger",
              "写入 staged/ 失败（HTTP " + putRes.status + "）：请检查令牌 Contents 读写权限。"
            );
            return;
          }

          var putOut = await putRes.json();
          var stagedUrl =
            (putOut && putOut.content && putOut.content.html_url) ||
            "https://github.com/" +
              conn.parsed.full +
              "/blob/" +
              encodeURIComponent(conn.branch) +
              "/" +
              art.path;

          setAlert(
            structResult,
            "ok",
            "脱敏草稿已存入私有库（可继续点击「一键触发同步 PR 至公开知识站」）：",
            { url: stagedUrl, label: art.path + " ↗" }
          );
        } catch (_e) {
          setAlert(structResult, "danger", "网络请求异常，请检查网络连接后重试。");
        } finally {
          syncWriteButtonsState();
        }
      });
    }

    // 一键触发私有库 promote-to-public.yml 同步工作流
    if (btnDispatchSync) {
      btnDispatchSync.addEventListener("click", async function () {
        var conn = await ensureVerifiedConn();
        if (!conn) {
          setAlert(
            structResult,
            "danger",
            blockedPublic
              ? "安全阻断：目标仓库不是 Private 私有仓库！"
              : "连接未就绪：请先在上方「私有库连接设置」保存并验证有效令牌。"
          );
          return;
        }

        btnDispatchSync.disabled = true;
        setAlert(structResult, "info", "正在请求触发私有库 promote-to-public.yml 同步工作流…");

        try {
          var dispatchUrl =
            "https://api.github.com/repos/" +
            conn.parsed.encoded +
            "/actions/workflows/promote-to-public.yml/dispatches";
          var res = await fetch(dispatchUrl, {
            method: "POST",
            headers: {
              Authorization: "Bearer " + conn.token,
              Accept: "application/vnd.github+json",
              "Content-Type": "application/json",
              "X-GitHub-Api-Version": "2022-11-28",
            },
            body: JSON.stringify({ ref: conn.branch }),
          });

          if (res.status === 204 || res.ok) {
            setAlert(
              structResult,
              "ok",
              "已成功触发受控同步工作流！稍后请前往公开知识库审阅并确认合并草稿 PR：",
              {
                url: "https://github.com/cvcingcvc-code/personal-knowledge-os/pulls",
                label: "查看公开知识站 PR 列表 ↗",
              }
            );
          } else {
            var msg =
              res.status === 403
                ? "触发被拒绝（HTTP 403）：请为 Fine-Grained Token 补充该私有库的 Actions: Read and write 权限，或直接在私有库 Actions 页面手动点 Run workflow。"
                : res.status === 404
                  ? "未找到 promote-to-public.yml 工作流（HTTP 404）：请确认私有库已完成同步工作流初始化，且令牌具备 Actions 权限。"
                  : "触发失败（HTTP " + res.status + "）。";
            setAlert(structResult, "danger", msg);
          }
        } catch (_e) {
          setAlert(structResult, "danger", "网络请求异常，无法触发同步工作流。");
        } finally {
          syncWriteButtonsState();
        }
      });
    }

    // ---- 异步加载全库条目以供 [[ 双链智能联想 ----
    async function loadKnowledgeEntries() {
      try {
        var base = "/personal-knowledge-os/";
        var res = await fetch(base + "data/content.json");
        if (res.ok) {
          var data = await res.json();
          if (data && Array.isArray(data.items)) {
            ALL_KNOWLEDGE_ENTRIES = data.items.map(function (it) {
              return {
                id: it.id,
                title: it.title || it.id,
                type: it.type,
                path: it.path || "",
              };
            });
          }
        }
      } catch (_e) {}
    }

    // 恢复结构化草稿
    function loadStructDraft() {
      try {
        var raw = localStorage.getItem(STORAGE_STRUCT_KEY);
        if (!raw) return;
        var d = JSON.parse(raw);
        if (d && typeof d === "object") {
          if (d.title && stTitle && !stTitle.value.trim()) stTitle.value = String(d.title);
          if (d.summary && stSummary && !stSummary.value.trim()) stSummary.value = String(d.summary);
          if (d.tags && stTags && !stTags.value.trim()) stTags.value = String(d.tags);
          if (d.body && stBody && !stBody.value.trim()) stBody.value = String(d.body);
          if (d.id && stId && !stId.value.trim()) stId.value = String(d.id);
          if (d.slug && stSlug && !stSlug.value.trim()) stSlug.value = String(d.slug);
        }
      } catch (_e) {}
    }

    // ---- 选中文本包裹与插入辅助 ----
    function wrapSelection(textarea, before, after, defaultText) {
      if (!textarea) return;
      var start = textarea.selectionStart;
      var end = textarea.selectionEnd;
      var val = textarea.value;
      var selected = val.substring(start, end) || defaultText || "";
      var replacement = before + selected + after;
      textarea.value = val.substring(0, start) + replacement + val.substring(end);
      textarea.focus();
      textarea.setSelectionRange(start + before.length, start + before.length + selected.length);
    }

    function insertLinePrefix(textarea, prefix) {
      if (!textarea) return;
      var start = textarea.selectionStart;
      var val = textarea.value;
      var lineStart = val.lastIndexOf("\n", start - 1) + 1;
      textarea.value = val.substring(0, lineStart) + prefix + val.substring(lineStart);
      textarea.focus();
      textarea.setSelectionRange(start + prefix.length, start + prefix.length);
    }

    // ---- Obsidian 视图模式切换与工具栏绑定 ----
    function setupEditorModes(editorName, wrapperEl, onUpdate) {
      var btns = document.querySelectorAll('.obsidian-mode-btn[data-editor="' + editorName + '"]');
      btns.forEach(function (btn) {
        btn.addEventListener("click", function () {
          var mode = btn.getAttribute("data-mode") || "edit";
          btns.forEach(function (b) {
            b.classList.toggle("is-active", b === btn);
          });
          if (wrapperEl) {
            wrapperEl.className = "obsidian-editor-wrapper mode-" + mode;
          }
          if (typeof onUpdate === "function") onUpdate();
        });
      });
    }

    function setupEditorToolbar(editorName, textareaEl, onUpdate) {
      var toolbar = document.querySelector('.obsidian-toolbar[data-editor="' + editorName + '"]');
      if (!toolbar) return;
      toolbar.addEventListener("click", function (e) {
        var btn = e.target.closest("[data-tool]");
        if (!btn) return;
        var tool = btn.getAttribute("data-tool");
        switch (tool) {
          case "bold":
            wrapSelection(textareaEl, "**", "**", "加粗文本");
            break;
          case "italic":
            wrapSelection(textareaEl, "*", "*", "斜体文本");
            break;
          case "h2":
            insertLinePrefix(textareaEl, "## ");
            break;
          case "quote":
            insertLinePrefix(textareaEl, "> ");
            break;
          case "code":
            wrapSelection(textareaEl, "```\n", "\n```", "代码块");
            break;
          case "task":
            insertLinePrefix(textareaEl, "- [ ] ");
            break;
          case "wikilink":
            wrapSelection(textareaEl, "[[", "]]", "条目ID|标题");
            break;
          case "tag":
            wrapSelection(textareaEl, "#", " ", "tag");
            break;
        }
        if (typeof onUpdate === "function") onUpdate();
      });
    }

    // ---- Obsidian 浮动智能补全系统 ([[双链与 #标签) ----
    var activeAutocomplete = null;

    function hidePopover() {
      if (obsidianPopover) obsidianPopover.hidden = true;
      activeAutocomplete = null;
    }

    function renderPopoverItems() {
      if (!popoverList || !activeAutocomplete) return;
      popoverList.innerHTML = "";
      var items = activeAutocomplete.items;
      if (items.length === 0) {
        var emptyLi = document.createElement("li");
        emptyLi.className = "obsidian-popover__item";
        emptyLi.innerHTML = '<span class="wb-hint">未找到匹配项</span>';
        popoverList.appendChild(emptyLi);
        return;
      }

      items.forEach(function (item, idx) {
        var li = document.createElement("li");
        li.className = "obsidian-popover__item" + (idx === activeAutocomplete.selectedIndex ? " is-selected" : "");
        li.setAttribute("role", "option");
        li.setAttribute("aria-selected", idx === activeAutocomplete.selectedIndex ? "true" : "false");

        if (activeAutocomplete.type === "wikilink") {
          var titleDiv = document.createElement("div");
          titleDiv.className = "obsidian-popover__title";
          titleDiv.textContent = item.title;
          var metaDiv = document.createElement("div");
          metaDiv.className = "obsidian-popover__meta";
          metaDiv.innerHTML = "<span>" + item.id + "</span><span>·</span><span>" + item.type + "</span>";
          li.appendChild(titleDiv);
          li.appendChild(metaDiv);
        } else {
          var tagSpan = document.createElement("span");
          tagSpan.className = "obsidian-tag";
          tagSpan.textContent = "#" + item;
          li.appendChild(tagSpan);
        }

        li.addEventListener("mousedown", function (e) {
          e.preventDefault();
          selectAutocompleteItem(idx);
        });

        popoverList.appendChild(li);
      });
    }

    function selectAutocompleteItem(idx) {
      if (!activeAutocomplete) return;
      var item = activeAutocomplete.items[idx];
      if (!item) return;
      var ta = activeAutocomplete.textarea;
      var cursor = ta.selectionStart;
      var before = ta.value.substring(0, activeAutocomplete.triggerIndex);
      var after = ta.value.substring(cursor);

      if (activeAutocomplete.type === "wikilink") {
        var insertStr = "[[" + item.id + "|" + item.title + "]]";
        if (after.indexOf("]]") === 0) after = after.substring(2);
        ta.value = before + insertStr + after;
        ta.focus();
        ta.setSelectionRange(before.length + insertStr.length, before.length + insertStr.length);
      } else if (activeAutocomplete.type === "tag") {
        var tagStr = "#" + item + " ";
        ta.value = before + tagStr + after;
        ta.focus();
        ta.setSelectionRange(before.length + tagStr.length, before.length + tagStr.length);
      }

      hidePopover();
      ta.dispatchEvent(new Event("input", { bubbles: true }));
    }

    function checkAutocompleteTrigger(ta) {
      var cursor = ta.selectionStart;
      var textBefore = ta.value.substring(0, cursor);

      // 检测双链 [[
      var wikiMatch = textBefore.match(/\[\[([^\]\n]*)$/);
      if (wikiMatch) {
        var query = wikiMatch[1].trim().toLowerCase();
        var matches = ALL_KNOWLEDGE_ENTRIES.filter(function (it) {
          return it.id.toLowerCase().indexOf(query) !== -1 ||
                 it.title.toLowerCase().indexOf(query) !== -1;
        }).slice(0, 8);

        activeAutocomplete = {
          textarea: ta,
          type: "wikilink",
          triggerIndex: cursor - wikiMatch[0].length,
          selectedIndex: 0,
          items: matches,
        };

        if (popoverTip) popoverTip.textContent = "关联全库已有条目 [[" + (query || "...");
        showPopoverNearTextarea(ta);
        renderPopoverItems();
        return;
      }

      // 检测受控标签 #
      var tagMatch = textBefore.match(/(?:^|\s)#([a-z0-9_-]*)$/i);
      if (tagMatch) {
        var tQuery = tagMatch[1].trim().toLowerCase();
        var tagMatches = CONTROLLED_TAGS_LIST.filter(function (tag) {
          return tag.indexOf(tQuery) !== -1;
        }).slice(0, 10);

        activeAutocomplete = {
          textarea: ta,
          type: "tag",
          triggerIndex: cursor - tagMatch[1].length - 1,
          selectedIndex: 0,
          items: tagMatches,
        };

        if (popoverTip) popoverTip.textContent = "选择受控分类标签 #" + (tQuery || "...");
        showPopoverNearTextarea(ta);
        renderPopoverItems();
        return;
      }

      hidePopover();
    }

    function showPopoverNearTextarea(ta) {
      if (!obsidianPopover) return;
      var rect = ta.getBoundingClientRect();
      var scrollY = window.pageYOffset || document.documentElement.scrollTop;
      var scrollX = window.pageXOffset || document.documentElement.scrollLeft;
      obsidianPopover.hidden = false;
      obsidianPopover.style.top = (rect.bottom + scrollY + 4) + "px";
      obsidianPopover.style.left = (rect.left + scrollX) + "px";
    }

    function attachTextareaObsidianHandlers(ta, saveTrigger) {
      if (!ta) return;

      ta.addEventListener("input", function () {
        checkAutocompleteTrigger(ta);
      });

      ta.addEventListener("keydown", function (e) {
        if (activeAutocomplete && obsidianPopover && !obsidianPopover.hidden) {
          if (e.key === "ArrowDown") {
            e.preventDefault();
            activeAutocomplete.selectedIndex = (activeAutocomplete.selectedIndex + 1) % Math.max(1, activeAutocomplete.items.length);
            renderPopoverItems();
            return;
          }
          if (e.key === "ArrowUp") {
            e.preventDefault();
            activeAutocomplete.selectedIndex = (activeAutocomplete.selectedIndex - 1 + activeAutocomplete.items.length) % Math.max(1, activeAutocomplete.items.length);
            renderPopoverItems();
            return;
          }
          if (e.key === "Enter" && !e.ctrlKey && !e.metaKey) {
            if (activeAutocomplete.items.length > 0) {
              e.preventDefault();
              selectAutocompleteItem(activeAutocomplete.selectedIndex);
              return;
            }
          }
          if (e.key === "Escape") {
            e.preventDefault();
            hidePopover();
            return;
          }
        }

        // 快捷键 1：Ctrl+Enter / Cmd+Enter 快速保存
        if ((e.ctrlKey || e.metaKey) && e.key === "Enter") {
          e.preventDefault();
          if (typeof saveTrigger === "function") saveTrigger();
          return;
        }

        // 快捷键 2：Tab 键插入 2 空格缩进
        if (e.key === "Tab") {
          e.preventDefault();
          var start = ta.selectionStart;
          var end = ta.selectionEnd;
          ta.value = ta.value.substring(0, start) + "  " + ta.value.substring(end);
          ta.selectionStart = ta.selectionEnd = start + 2;
          ta.dispatchEvent(new Event("input", { bubbles: true }));
          return;
        }

        // 快捷键 3：Ctrl+B 加粗
        if ((e.ctrlKey || e.metaKey) && (e.key === "b" || e.key === "B")) {
          e.preventDefault();
          wrapSelection(ta, "**", "**", "粗体文本");
          ta.dispatchEvent(new Event("input", { bubbles: true }));
          return;
        }

        // 快捷键 4：Ctrl+I 斜体
        if ((e.ctrlKey || e.metaKey) && (e.key === "i" || e.key === "I")) {
          e.preventDefault();
          wrapSelection(ta, "*", "*", "斜体文本");
          ta.dispatchEvent(new Event("input", { bubbles: true }));
          return;
        }

        // 快捷键 5：Ctrl+K 链接
        if ((e.ctrlKey || e.metaKey) && (e.key === "k" || e.key === "K")) {
          e.preventDefault();
          wrapSelection(ta, "[", "](url)", "链接文本");
          ta.dispatchEvent(new Event("input", { bubbles: true }));
          return;
        }
      });

      ta.addEventListener("blur", function () {
        setTimeout(hidePopover, 200);
      });
    }

    // 绑定视图切换与工具栏
    setupEditorModes("quick", quickEditorWrap, function () {
      updateQuickPreviewAndCache(false);
    });
    setupEditorToolbar("quick", quickBody, function () {
      updateQuickPreviewAndCache(true);
    });
    attachTextareaObsidianHandlers(quickBody, function () {
      if (btnSaveInbox) btnSaveInbox.click();
    });

    setupEditorModes("struct", structEditorWrap, function () {
      refreshStructuredPreview();
    });
    setupEditorToolbar("struct", stBody, function () {
      refreshStructuredPreview();
    });
    attachTextareaObsidianHandlers(stBody, function () {
      if (btnSaveStaged) btnSaveStaged.click();
    });

    // 启动时恢复本地连接、快速草稿与初始预览
    loadSavedConn();
    loadKnowledgeEntries();
    loadQuickDraft();
    loadStructDraft();
    updateQuickPreviewAndCache(false);
    refreshStructuredPreview();
  })();
</script>
